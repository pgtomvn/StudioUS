{
  "name": "hcmus-study-progress",
  "version": "0.0.0",
  "private": true,
  "description": "Không gian dự án quản lý tiến độ học tập cá nhân ngành Kỹ thuật Phần mềm HCMUS K2025.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/generate-pixel-assets.mjs",
    "sfx": "node scripts/generate-sfx.mjs",
    "doctor": "node scripts/check-environment.mjs",
    "progress": "node scripts/update-progress.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run doctor && npm run format:check && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
